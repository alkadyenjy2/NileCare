# Admin sign-in supports Google OAuth and a temporary Preview-only password fallback.
# Never commit real values. Production must not receive ADMIN_PASSWORD_SHA256.
# AUTH_SECRET must be a random secret with at least 32 characters.
AUTH_SECRET=
ADMIN_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# SHA-256 hex digest of a randomly generated password (64 hex chars); Preview branch only.
ADMIN_PASSWORD_SHA256=
# Canonical HTTPS origin for the exact Vercel project/domain.
# Must match the authorized redirect URI configured in Google Cloud:
# https://YOUR_HOST/api/admin/auth/callback
NILECARE_PUBLIC_URL=
# The admin read-only dashboard uses the existing DATABASE_URL (Neon).
# Keep Preview DB separate. Do not copy Production credentials into Preview.
DATABASE_URL=
