# Admin sign-in uses Google OAuth; never commit real values.
# AUTH_SECRET must be a random secret with at least 32 characters.
AUTH_SECRET=
ADMIN_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Canonical HTTPS origin for the exact Vercel project/domain.
# Must match the authorized redirect URI configured in Google Cloud:
# https://YOUR_HOST/api/admin/auth/callback
NILECARE_PUBLIC_URL=
# The admin read-only dashboard uses the existing DATABASE_URL (Neon).
# Keep Preview DB separate from Production. Do not copy Production credentials into Preview.
DATABASE_URL=
