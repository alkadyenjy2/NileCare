# NileCare production persistence
NILECARE_PERSISTENCE_PROVIDER=neon
DATABASE_URL=

# Optional legacy-compatible persistence override
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public lead/contact surface
