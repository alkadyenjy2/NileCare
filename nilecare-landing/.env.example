# Application/webhook secrets
NILECARE_WEBHOOK_SECRET=

# Set to true only after jurisdiction-specific legal/privacy review; reference an approved document or review record.
NILECARE_LEGAL_REVIEW_APPROVED=false
NILECARE_LEGAL_REVIEW_REFERENCE=

# Set to true only after a real clinic has approved the written service scope/terms; reference the signed agreement.
NILECARE_CLINIC_PARTNER_APPROVED=false
NILECARE_CLINIC_PARTNER_REFERENCE=
WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Paymob
PAYMOB_SECRET_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=

# WhatsApp Cloud API
WABA_ID=
PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Meta
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=

# AI
HF_API_TOKEN=
HF_MODEL=

# Admin dashboard: use random secrets of at least 32 characters; never commit real values.
